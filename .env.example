# ===================================================
# Cyrus B. Reyes Portfolio — SMTP Configuration
# ===================================================
# This file serves as an example. Copy this to `.env.local`
# and fill in your actual credentials.
#
# For Gmail (Recommended):
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/security
# 2. Generate an "App Password" (choose "Mail" / custom name "Portfolio"):
#    https://myaccount.google.com/apppasswords
# 3. Paste the 16-character generated password below for SMTP_PASS.
# ===================================================

# SMTP Host (defaults to smtp.gmail.com)
SMTP_HOST=smtp.gmail.com

# SMTP Port: 465 for SSL (recommended), or 587 for TLS
SMTP_PORT=465

# Set to true for port 465, or false for port 587
SMTP_SECURE=true

# Your Gmail address or SMTP username
SMTP_USER=cyrusreyes1313@gmail.com

# Your 16-character Google App Password (e.g., abcd efgh ijkl mnop)
SMTP_PASS=your-google-app-password-here

# Recipient email address where contact messages will be delivered
CONTACT_RECEIVER_EMAIL=cyrusreyes1313@gmail.com
